<Window x:Class="Qingjian.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出" Width="910" Height="704" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Loaded="LoadPreview">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="FieldText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="9,3"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SegmentedTrack" TargetType="Border">
            <Setter Property="Background" Value="#0E1014"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="2.5"/>
        </Style>
        <Style x:Key="ExportChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Choice" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="4.5" Padding="6,0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="{StaticResource Raised}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="{StaticResource AccentSubtle}"/>
                                <Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource AccentBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExportCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- Dialog Header -->
        <Border Padding="20,0" Background="{StaticResource SurfaceAlt}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Line}">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="10" Padding="10,2.5" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="ProjectLabel" FontSize="11" Foreground="{StaticResource TextSecondary}"
                               MaxWidth="300" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 2,10 L 2,13.5 L 13,13.5 L 13,10 M 7.5,9.5 L 7.5,1.5 M 4.2,4.8 L 7.5,1.5 L 10.8,4.8"
                          Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock Text="导出" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="本地多格式导出引擎" Style="{StaticResource MutedText}" FontSize="11"
                               Margin="10,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main 2-Column Body -->
        <Grid Grid.Row="1" Margin="18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="318"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Preview, Cover, Export Scope & Output Summary -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Frame & Cover Preview -->
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <Border Height="152" Background="{StaticResource Stage}" CornerRadius="6" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" ClipToBounds="True" Padding="6">
                            <Grid x:Name="PreviewHost" SizeChanged="ResizePreview">
                                <Border x:Name="PreviewFrame" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="#030405" BorderBrush="#1C2029" BorderThickness="1">
                                    <Image x:Name="FrameImage" Stretch="Uniform" AutomationProperties.Name="导出画面预览"/>
                                </Border>
                            </Grid>
                        </Border>
                        <DockPanel Margin="2,8,2,0">
                            <TextBlock x:Name="PreviewGeometry" DockPanel.Dock="Right" FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10.5" Foreground="{StaticResource Accent}" Margin="8,0,0,0"/>
                            <TextBlock x:Name="PreviewKind" Text="正在读取首帧…" Style="{StaticResource MutedText}" FontSize="11"/>
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,9,0,8"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="选择封面…" Click="ChooseCoverClick" Height="24" MinHeight="24" Padding="8,0"
                                        FontSize="11" Margin="0,0,4,0"/>
                                <Button x:Name="ResetCoverBtn" Content="还原" Click="ResetCoverClick" Height="24" MinHeight="24"
                                        Padding="7,0" FontSize="11" Visibility="Collapsed"/>
                            </StackPanel>
                            <CheckBox x:Name="ExportWithCover" Content="带封面导出" VerticalAlignment="Center"
                                      Checked="SettingsChanged" Unchecked="SettingsChanged"
                                      ToolTip="在 MP4 / MOV 文件中嵌入封面缩略图"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Export Scope Card -->
                <Border Style="{StaticResource SectionCard}" Margin="0,10,0,10">
                    <StackPanel>
                        <TextBlock Text="导出范围" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,7"/>
                        <Border Style="{StaticResource SegmentedTrack}">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="ScopeFull" GroupName="ExportScope" Content="全时间线" IsChecked="True"
                                             Style="{StaticResource ExportChoice}" Checked="ScopeChanged"/>
                                <RadioButton x:Name="ScopeRange" GroupName="ExportScope" Content="入出点选区"
                                             Style="{StaticResource ExportChoice}" Checked="ScopeChanged"/>
                                <RadioButton x:Name="ScopeClip" GroupName="ExportScope" Content="当前片段"
                                             Style="{StaticResource ExportChoice}" Checked="ScopeChanged"/>
                            </UniformGrid>
                        </Border>

                        <!-- Range Inputs -->
                        <StackPanel x:Name="RangePanel" Visibility="Collapsed" Margin="0,9,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="入点 (秒)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="RangeStartBox" Style="{StaticResource FieldText}" Text="0.00"
                                             FontFamily="Cascadia Mono, Consolas" TextChanged="SettingsChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="出点 (秒)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="RangeEndBox" Style="{StaticResource FieldText}" Text="0.00"
                                             FontFamily="Cascadia Mono, Consolas" TextChanged="SettingsChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Selected Clip Options -->
                        <StackPanel x:Name="ClipScopePanel" Visibility="Collapsed" Margin="0,9,0,0">
                            <TextBlock x:Name="SelectedClipDesc" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6"/>
                            <CheckBox x:Name="IncludeClipEffects" Content="包含裁剪、变换、文字与画中画效果" IsChecked="True"
                                      Checked="SettingsChanged" Unchecked="SettingsChanged"
                                      ToolTip="关闭后仅保留片段位置、缩放与变速等基础画面参数"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Output Summary & Disk Telemetry -->
                <Border Style="{StaticResource SectionCard}" Margin="0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock x:Name="DiskSpaceText" DockPanel.Dock="Right" FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10.5" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="待导出产物" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        </DockPanel>
                        <TextBlock x:Name="Summary" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="OutputFilesSummary" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"
                                   TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"/>
                        <TextBlock x:Name="DiskWarningText" Foreground="{StaticResource WarnText}" FontSize="11"
                                   Margin="0,5,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: Scrollable Export Cards -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <!-- Destination Card -->
                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.25*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="文件名称" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="FileNameBox" Style="{StaticResource FieldText}"
                                         AutomationProperties.Name="导出文件名" TextChanged="SettingsChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="导出至" Style="{StaticResource FieldLabel}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="浏览…" Margin="6,0,0,0" Height="30" MinHeight="30"
                                            Padding="10,0" Click="ChooseDirectory" AutomationProperties.Name="选择输出文件夹"/>
                                    <TextBox x:Name="FolderBox" Style="{StaticResource FieldText}"
                                             AutomationProperties.Name="导出文件夹" TextChanged="SettingsChanged"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CARD 1: VIDEO EXPORT -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="ToggleAdvVideoBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                        Content="高级设置 ▾" Click="ToggleAdvVideoClick" Height="24" MinHeight="24"
                                        Padding="8,0" FontSize="11" Foreground="{StaticResource Accent}"/>
                                <CheckBox x:Name="ExportVideoCheck" Content="视频导出" IsChecked="True" FontSize="13" FontWeight="SemiBold"
                                          Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                            </DockPanel>

                            <StackPanel x:Name="VideoOptionsBody" Margin="0,10,0,0">
                                <!-- Row 1: Resolution + Frame Rate -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="分辨率" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="ResolutionCombo" Style="{StaticResource ExportCombo}" SelectionChanged="ComboChanged">
                                            <ComboBoxItem Content="480P（标清）" Tag="480"/>
                                            <ComboBoxItem Content="720P（高清）" Tag="720"/>
                                            <ComboBoxItem Content="1080P（全高清）" Tag="1080" IsSelected="True"/>
                                            <ComboBoxItem Content="2K（1440P）" Tag="1440"/>
                                            <ComboBoxItem Content="4K（2160P）" Tag="2160"/>
                                            <ComboBoxItem Content="8K（4320P）" Tag="4320"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="帧率" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="FpsCombo" Style="{StaticResource ExportCombo}" SelectionChanged="ComboChanged">
                                            <ComboBoxItem Content="24 fps" Tag="24"/>
                                            <ComboBoxItem Content="25 fps" Tag="25"/>
                                            <ComboBoxItem Content="29.97 fps" Tag="29.97"/>
                                            <ComboBoxItem Content="30 fps" Tag="30" IsSelected="True"/>
                                            <ComboBoxItem Content="50 fps" Tag="50"/>
                                            <ComboBoxItem Content="59.94 fps" Tag="59.94"/>
                                            <ComboBoxItem Content="60 fps" Tag="60"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Codec + Container -->
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="视频编码" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CodecCombo" Style="{StaticResource ExportCombo}" SelectionChanged="CodecChanged">
                                            <ComboBoxItem Content="H.264（通用兼容）" Tag="H264" IsSelected="True"/>
                                            <ComboBoxItem Content="HEVC / H.265（高压缩）" Tag="Hevc"/>
                                            <ComboBoxItem Content="HEVC 4:2:2 10-bit" Tag="Hevc422"/>
                                            <ComboBoxItem Content="AV1（极省空间）" Tag="Av1"/>
                                            <ComboBoxItem Content="Apple ProRes Proxy" Tag="ProResProxy"/>
                                            <ComboBoxItem Content="Apple ProRes 422 LT" Tag="ProResLt"/>
                                            <ComboBoxItem Content="Apple ProRes 422" Tag="ProRes422"/>
                                            <ComboBoxItem Content="Apple ProRes 422 HQ" Tag="ProRes422Hq"/>
                                            <ComboBoxItem Content="Apple ProRes 4444 (Alpha)" Tag="ProRes4444"/>
                                            <ComboBoxItem Content="QuickTime RLE" Tag="Rle"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="封装格式" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource SegmentedTrack}">
                                            <UniformGrid Rows="1">
                                                <RadioButton x:Name="ContainerMp4" GroupName="Container" Content="MP4" IsChecked="True"
                                                             Style="{StaticResource ExportChoice}" Checked="ContainerChanged"/>
                                                <RadioButton x:Name="ContainerMov" GroupName="Container" Content="MOV"
                                                             Style="{StaticResource ExportChoice}" Checked="ContainerChanged"/>
                                                <RadioButton x:Name="ContainerMxf" GroupName="Container" Content="MXF"
                                                             Style="{StaticResource ExportChoice}" Checked="ContainerChanged"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 3: Bitrate Preset & CBR/VBR -->
                                <StackPanel x:Name="BitrateSection" Margin="0,9,0,0">
                                    <DockPanel Margin="0,0,0,4">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <RadioButton x:Name="RateVbr" GroupName="RateMode" Content="VBR 动态" IsChecked="True"
                                                         Style="{StaticResource ExportChoice}" Height="20" FontSize="10.5" Margin="0,0,4,0"
                                                         Checked="SettingsChanged"/>
                                            <RadioButton x:Name="RateCbr" GroupName="RateMode" Content="CBR 静态"
                                                         Style="{StaticResource ExportChoice}" Height="20" FontSize="10.5"
                                                         Checked="SettingsChanged"/>
                                        </StackPanel>
                                        <TextBlock Text="视频码率" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SegmentedTrack}">
                                            <UniformGrid Rows="1">
                                                <RadioButton x:Name="BitrateLow" GroupName="BitratePreset" Content="更低"
                                                             Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                                <RadioButton x:Name="BitrateRec" GroupName="BitratePreset" Content="推荐" IsChecked="True"
                                                             Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                                <RadioButton x:Name="BitrateHigh" GroupName="BitratePreset" Content="更高"
                                                             Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                                <RadioButton x:Name="BitrateCustom" GroupName="BitratePreset" Content="自定义"
                                                             Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                            </UniformGrid>
                                        </Border>
                                        <StackPanel x:Name="CustomBitrateWrap" Grid.Column="1" Orientation="Horizontal"
                                                    Margin="8,0,0,0" Visibility="Collapsed">
                                            <TextBox x:Name="BitrateBox" Width="74" Height="30" MinHeight="30" Padding="7,3"
                                                     FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Text="10000"
                                                     TextChanged="SettingsChanged"/>
                                            <TextBlock Text="kbps" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Collapsible Advanced Video & Embedded Audio -->
                                <Border x:Name="AdvVideoPanel" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,9"
                                        CornerRadius="6" Background="#101217" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="0.8*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="色彩空间" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="ColorSpaceCombo" Style="{StaticResource ExportCombo}" SelectionChanged="ComboChanged">
                                                    <ComboBoxItem Content="Rec.709 SDR（标准）" Tag="Rec709Sdr" IsSelected="True"/>
                                                    <ComboBoxItem Content="Rec.2020 SDR (10-bit)" Tag="Rec2020Sdr"/>
                                                    <ComboBoxItem Content="Rec.2100 HLG HDR (10-bit)" Tag="Rec2100Hlg"/>
                                                    <ComboBoxItem Content="Rec.2100 PQ HDR (10-bit)" Tag="Rec2100Pq"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                                <CheckBox x:Name="BitDepth10Check" Content="10 Bit 色深"
                                                          Checked="SettingsChanged" Unchecked="SettingsChanged"
                                                          ToolTip="HDR 建议使用 10-bit（HEVC / AV1 / ProRes）"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.15*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="0.85*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="视频内嵌音频质量" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="VideoAudioCombo" Style="{StaticResource ExportCombo}" SelectionChanged="ComboChanged">
                                                    <ComboBoxItem Content="AAC 192 kbps" Tag="Aac192" IsSelected="True"/>
                                                    <ComboBoxItem Content="AAC 256 kbps" Tag="Aac256"/>
                                                    <ComboBoxItem Content="AAC 320 kbps" Tag="Aac320"/>
                                                    <ComboBoxItem Content="PCM 无损（MOV / MXF）" Tag="PcmLossless"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="音频采样率" Style="{StaticResource FieldLabel}"/>
                                                <Border Style="{StaticResource SegmentedTrack}">
                                                    <UniformGrid Rows="1">
                                                        <RadioButton x:Name="VideoSr441" GroupName="VideoSr" Content="44.1kHz"
                                                                     Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                                        <RadioButton x:Name="VideoSr48" GroupName="VideoSr" Content="48kHz" IsChecked="True"
                                                                     Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                                    </UniformGrid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <WrapPanel Margin="0,9,0,0">
                                            <CheckBox x:Name="FastStartCheck" Content="网络播放优化（faststart 边加载边播放）" IsChecked="True"
                                                      Margin="0,0,16,4" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                                            <CheckBox x:Name="Hardware" Content="优先 GPU 硬件编码（NVENC / QSV / AMF）" IsChecked="True"
                                                      Margin="0,0,0,4" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: STANDALONE AUDIO EXPORT -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="MP3 / WAV / AAC / FLAC / AIFF / OGG"
                                           Style="{StaticResource MutedText}" FontSize="10.5" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ExportAudioCheck" Content="音频导出" FontSize="13" FontWeight="SemiBold"
                                          Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                            </DockPanel>
                            <StackPanel x:Name="AudioOptionsBody" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock Text="音频格式" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource SegmentedTrack}">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="AudMp3" GroupName="AudFmt" Content="MP3" IsChecked="True" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                        <RadioButton x:Name="AudWav" GroupName="AudFmt" Content="WAV" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                        <RadioButton x:Name="AudAac" GroupName="AudFmt" Content="AAC" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                        <RadioButton x:Name="AudFlac" GroupName="AudFmt" Content="FLAC" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                        <RadioButton x:Name="AudAiff" GroupName="AudFmt" Content="AIFF" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                        <RadioButton x:Name="AudOgg" GroupName="AudFmt" Content="OGG" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                    </UniformGrid>
                                </Border>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="0.85*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="AudioBitratePanel">
                                        <TextBlock Text="比特率" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource SegmentedTrack}">
                                            <UniformGrid Rows="1">
                                                <RadioButton x:Name="AudBr192" GroupName="AudBr" Content="192k" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                                <RadioButton x:Name="AudBr256" GroupName="AudBr" Content="256k" IsChecked="True" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                                <RadioButton x:Name="AudBr320" GroupName="AudBr" Content="320k" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="采样率" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource SegmentedTrack}">
                                            <UniformGrid Rows="1">
                                                <RadioButton x:Name="AudSr441" GroupName="AudSr" Content="44.1kHz" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                                <RadioButton x:Name="AudSr48" GroupName="AudSr" Content="48kHz" IsChecked="True" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: SUBTITLE EXPORT -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="SubtitleAvailText" DockPanel.Dock="Right" Text="SRT / TXT"
                                           Style="{StaticResource MutedText}" FontSize="10.5" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ExportSubtitleCheck" Content="字幕导出" FontSize="13" FontWeight="SemiBold"
                                          Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                            </DockPanel>
                            <StackPanel x:Name="SubtitleOptionsBody" Visibility="Collapsed" Margin="0,10,0,0">
                                <Border Style="{StaticResource SegmentedTrack}">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="SubSrt" GroupName="SubFmt" Content="SRT 标准字幕 (.srt)" IsChecked="True"
                                                     Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                        <RadioButton x:Name="SubTxt" GroupName="SubFmt" Content="TXT 纯文本 (.txt)"
                                                     Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 4: GIF EXPORT -->
                    <Border Style="{StaticResource SectionCard}" Margin="0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="240P / 320P / 480P / 640P"
                                           Style="{StaticResource MutedText}" FontSize="10.5" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ExportGifCheck" Content="GIF 动图导出" FontSize="13" FontWeight="SemiBold"
                                          Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                            </DockPanel>
                            <StackPanel x:Name="GifOptionsBody" Visibility="Collapsed" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="0.75*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="GIF 分辨率" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource SegmentedTrack}">
                                            <UniformGrid Rows="1">
                                                <RadioButton x:Name="Gif240" GroupName="GifRes" Content="240P" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                                <RadioButton x:Name="Gif320" GroupName="GifRes" Content="320P" IsChecked="True" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                                <RadioButton x:Name="Gif480" GroupName="GifRes" Content="480P" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                                <RadioButton x:Name="Gif640" GroupName="GifRes" Content="640P" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="帧率" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource SegmentedTrack}">
                                            <UniformGrid Rows="1">
                                                <RadioButton x:Name="GifFps10" GroupName="GifFps" Content="10" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                                <RadioButton x:Name="GifFps15" GroupName="GifFps" Content="15" IsChecked="True" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                                <RadioButton x:Name="GifFps20" GroupName="GifFps" Content="20" Style="{StaticResource ExportChoice}" Checked="SettingsChanged"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="GifDurationWarn" Foreground="{StaticResource WarnText}" FontSize="11"
                                           Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Background="{StaticResource SurfaceAlt}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="取消" IsCancel="True" Width="76" Height="32" Margin="0,0,8,0"/>
                    <Button x:Name="StartExportBtn" Content="开始导出" Style="{StaticResource Primary}" IsDefault="True"
                            Click="ConfirmOutput" MinWidth="116" Height="32" Padding="14,0"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FileEstimate" FontFamily="Cascadia Mono, Consolas"
                               FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="Validation" Foreground="#FF8787" FontSize="11" TextWrapping="Wrap"
                               Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
