<Window x:Class="Qingjian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Qingjian"
        Title="清剪" Width="1420" Height="880" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        FontSize="12.5" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True"
        PreviewKeyDown="OnKeyDown" PreviewMouseMove="AssetMouseMove" PreviewMouseLeftButtonUp="AssetMouseUp"
        DragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing" StateChanged="OnWindowStateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="PaneDivider" TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource Canvas}"/>
            <Setter Property="ShowsPreview" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBorder}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PaneHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
        </Style>
        <Style x:Key="InspectorCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="KbdBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Raised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolbarDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Background" Value="{StaticResource LineStrong}"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ColorDot" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Dot" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LineStrong}" BorderThickness="1.5"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextPresetCard" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBg" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBg" Property="Background" Value="{StaticResource Raised}"/>
                                <Setter TargetName="CardBg" Property="BorderBrush" Value="{StaticResource AccentBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowRootBorder" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid Background="{StaticResource Canvas}">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="2.7*" MinHeight="260"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="2.15*" MinHeight="274"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- INTEGRATED FRAMELESS TOP COMMAND BAR -->
            <Border Grid.Row="0" Background="#121419" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="10,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand + Document Commands -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,7,0"
                                BorderBrush="{StaticResource AccentBorder}" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#143740" Offset="0"/>
                                    <GradientStop Color="#0D1C22" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 2,7 L 2,2 L 7,2 M 14,9 L 14,14 L 9,14 M 5,11 L 11,5"/>
                        </Border>
                        <TextBlock Text="清剪" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>

                        <StackPanel x:Name="EditorTopNav" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Style="{StaticResource ToolbarDivider}" Margin="10,0,6,0"/>
                            <Button Style="{StaticResource GhostButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="BackToHomeClick" Margin="0,0,1,0" ToolTip="返回首页草稿与工具">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 1.5,7.2 L 7.5,2 L 13.5,7.2 M 3.5,6.2 L 3.5,12.5 L 11.5,12.5 L 11.5,6.2"
                                          Width="12.5" Height="12.5" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.35" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="首页" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="NewClick" Margin="0,0,1,0" ToolTip="新建项目 · Ctrl+N">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 3,1.5 L 8.5,1.5 L 12,5 L 12,13.5 L 3,13.5 Z M 8.5,1.5 L 8.5,5 L 12,5"
                                          Width="12.5" Height="12.5" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.35" StrokeLineJoin="Round" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="新建" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="OpenClick" Margin="0,0,1,0" ToolTip="打开项目 · Ctrl+O">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 1.5,4 L 6,4 L 7.5,6 L 13.5,6 L 13.5,12.5 L 1.5,12.5 Z"
                                          Width="12.5" Height="12.5" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.35" StrokeLineJoin="Round" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="打开" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="SaveClick" ToolTip="保存项目 · Ctrl+S">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 2.5,2 L 10.5,2 L 13,4.5 L 13,13 L 2.5,13 Z M 5,2 L 5,5.5 L 10,5.5 L 10,2 M 5,13 L 5,8.5 L 10.5,8.5 L 10.5,13"
                                          Width="12.5" Height="12.5" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.3" StrokeLineJoin="Round" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="保存" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Clickable Project & Recent Projects Pill -->
                    <Grid x:Name="EditorTopCenter" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed">
                        <Button x:Name="ProjectMenuButton" WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="ProjectMenuClick" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                ToolTip="点击切换最近项目或另存为">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PillBg" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" CornerRadius="12" Padding="12,4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PillBg" Property="Background" Value="{StaticResource Hover}"/>
                                            <Setter TargetName="PillBg" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ProjectDirtyDot" Width="6" Height="6" Fill="{StaticResource Accent}"
                                         Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="ProjectTitle" Text="未命名项目" MaxWidth="250" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <Path Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="{StaticResource Muted}" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Margin="8,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Recent Projects Dropdown Popup -->
                        <Popup x:Name="RecentPopup" PlacementTarget="{Binding ElementName=ProjectMenuButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Margin="0,5,0,0" Width="300" CornerRadius="9" Background="#191C23"
                                    BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="最近项目" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                               Margin="6,2,6,6"/>
                                    <ItemsControl x:Name="RecentList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                                        Padding="8,6" Click="RecentProjectClick" Tag="{Binding Path}">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" Background="{StaticResource Background}"
                                                                CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Format}" FontFamily="Cascadia Mono, Consolas"
                                                                       FontSize="10" Foreground="{StaticResource Muted}"/>
                                                        </Border>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                                                       Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{StaticResource Muted}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,1,8,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="RecentEmptyText" Text="暂无最近保存的本地项目" Style="{StaticResource MutedText}"
                                               Margin="8,4,8,8"/>
                                    <Border Height="1" Background="{StaticResource Line}" Margin="4,4,4,6"/>
                                    <UniformGrid Columns="2">
                                        <Button Style="{StaticResource GhostButton}" Content="另存为…" Click="SaveAsClick" Margin="0,0,3,0"/>
                                        <Button Style="{StaticResource GhostButton}" Content="打开项目…" Click="OpenFromMenuClick" Margin="3,0,0,0"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Right: Export CTA + Custom Window Chrome Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="ExportButton" Style="{StaticResource Primary}" WindowChrome.IsHitTestVisibleInChrome="True"
                                Height="28" MinHeight="28" Padding="13,0" Click="ExportClick" IsEnabled="False"
                                Visibility="Collapsed" AutomationProperties.Name="导出视频">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 2,10 L 2,13.5 L 13,13.5 L 13,10 M 7.5,9.5 L 7.5,1.5 M 4.2,4.8 L 7.5,1.5 L 10.8,4.8"
                                      Width="12.5" Height="12.5" Stretch="Uniform" Stroke="{StaticResource AccentDark}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="导出视频" FontSize="12" Foreground="{StaticResource AccentDark}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Style="{StaticResource ToolbarDivider}" Margin="10,0,4,0"/>

                        <Button Style="{StaticResource ChromeCaptionButton}" Click="MinimizeClick" ToolTip="最小化">
                            <Path Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource ChromeCaptionButton}" Click="MaximizeClick" ToolTip="最大化 / 还原">
                            <Path x:Name="MaximizeGlyph" Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" Width="10" Height="10"/>
                        </Button>
                        <Button Style="{StaticResource ChromeCloseButton}" Click="CloseWindowClick" ToolTip="关闭">
                            <Path Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- UPPER 3-PANE WORKSPACE -->
            <Grid Grid.Row="1" Margin="4,4,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" MinWidth="264"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="1.62*" MinWidth="380"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="0.92*" MinWidth="272"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANE: MINIMALIST LOCAL 3-TAB RESOURCE BIN -->
                <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 3 Local Tabs: 素材 / 音频 / 文字 -->
                        <Border Style="{StaticResource PaneHeader}" Padding="4,0">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="TabMedia" GroupName="ResourceTabs" IsChecked="True"
                                             Style="{StaticResource ResourceTabRadio}" Checked="ResourceTabChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 1.5,2.5 L 12.5,2.5 L 12.5,11.5 L 1.5,11.5 Z M 1.5,5.2 L 12.5,5.2 M 5,2.5 L 5,5.2 M 9,2.5 L 9,5.2"
                                              Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.3" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="素材" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="TabAudio" GroupName="ResourceTabs"
                                             Style="{StaticResource ResourceTabRadio}" Checked="ResourceTabChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 2,7 L 2,11 M 5,4 L 5,14 M 8,2 L 8,16 M 11,5 L 11,13 M 14,7 L 14,11"
                                              Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="音频" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="TabText" GroupName="ResourceTabs"
                                             Style="{StaticResource ResourceTabRadio}" Checked="ResourceTabChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 2,2.5 L 12,2.5 M 7,2.5 L 7,12.5 M 4.8,12.5 L 9.2,12.5"
                                              Width="11.5" Height="11.5" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="文字" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </Border>

                        <!-- TAB 1: MEDIA BIN -->
                        <Grid Grid.Row="1" x:Name="MediaTabView">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="38"/>
                            </Grid.RowDefinitions>

                            <!-- Import + Search Row -->
                            <Grid Margin="9,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ImportButton" Style="{StaticResource AccentSubtleButton}"
                                        Height="29" MinHeight="29" Padding="9,0" Margin="0,0,7,0" Click="ImportClick"
                                        Visibility="Collapsed" ToolTip="导入本地视频或音频 · Ctrl+I">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 5.5,1 L 5.5,10 M 1,5.5 L 10,5.5" Width="9.5" Height="9.5" Stretch="Uniform"
                                              Stroke="{StaticResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                              Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="导入" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="AssetSearch" TextChanged="AssetSearchChanged"
                                             AutomationProperties.Name="搜索素材文件名" Padding="27,4,8,4" Height="29" MinHeight="29"/>
                                    <Path Data="M 5.5,1 A 4.5,4.5 0 1 0 5.5,10 A 4.5,4.5 0 1 0 5.5,1 Z M 9,9 L 12,12"
                                          Width="11.5" Height="11.5" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.35"
                                          StrokeStartLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Margin="9,0,0,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="搜索素材" Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=AssetSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Border Grid.Column="2" Background="{StaticResource Raised}" CornerRadius="8" Padding="6,2"
                                        Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AssetCount" Text="0" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10" Foreground="{StaticResource Muted}"/>
                                </Border>
                            </Grid>

                            <!-- Asset Wrap Grid -->
                            <ListBox x:Name="AssetList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="8,2,4,2"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="AssetDoubleClick"
                                     PreviewMouseLeftButtonDown="AssetMouseDown" PreviewMouseRightButtonUp="AssetRightClick"
                                     SelectionChanged="AssetSelectionChanged" AutomationProperties.Name="项目素材">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Width" Value="132"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,6,7"/>
                                        <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="AssetItemBorder" CornerRadius="7" Background="{TemplateBinding Background}"
                                                            BorderThickness="1" BorderBrush="{StaticResource Line}" Padding="5"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="AssetItemBorder" Property="Background" Value="{StaticResource Raised}"/>
                                                            <Setter TargetName="AssetItemBorder" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="AssetItemBorder" Property="Background" Value="{StaticResource AccentSubtle}"/>
                                                            <Setter TargetName="AssetItemBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Border Height="70" Background="#0A0B0E" CornerRadius="5" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                    <Border CornerRadius="5">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Asset.IsAudioOnly}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#172942" Offset="0"/>
                                                                <GradientStop Color="#0E1726" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Path Data="M 2,10 L 2,14 M 5,6 L 5,18 M 8,3 L 8,21 M 11,7 L 11,17 M 14,5 L 14,19 M 17,9 L 17,15"
                                                              Width="30" Height="22" Stretch="Uniform" Stroke="#5B9EF2" StrokeThickness="2"
                                                              StrokeStartLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Duration Pill -->
                                                    <Border Background="#C8080A0D" CornerRadius="3.5" Padding="5,1"
                                                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4">
                                                        <TextBlock Text="{Binding Asset.DurationText}" FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="9.5" Foreground="#EDEDEF"/>
                                                    </Border>
                                                    <!-- Quick Add to V2 (PiP) & V1 (+) -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4">
                                                        <Button Click="QuickOverlayClick" Tag="{Binding}" ToolTip="在播放头处添加为画中画（V2）"
                                                                Width="21" Height="21" MinHeight="21" Padding="0" Margin="0,0,3,0"
                                                                Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Asset.IsAudioOnly}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="PipPill" CornerRadius="10.5" Background="#D814171D"
                                                                            BorderBrush="{StaticResource TrackOverlayTag}" BorderThickness="1">
                                                                        <Path x:Name="PipIcon" Data="M 1,1 L 9,1 L 9,7 L 1,7 Z M 5,3.5 L 8,3.5 L 8,6 L 5,6 Z"
                                                                              Width="9.5" Height="8" Stretch="Uniform"
                                                                              Stroke="#A8B2FF" StrokeThickness="1.2"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="PipPill" Property="Background" Value="{StaticResource TrackOverlayTag}"/>
                                                                            <Setter TargetName="PipIcon" Property="Stroke" Value="#0A0C14"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button Click="QuickAppendClick" Tag="{Binding}" ToolTip="添加到主轨末尾（V1）"
                                                                Width="21" Height="21" MinHeight="21" Padding="0"
                                                                Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="AddPill" CornerRadius="10.5" Background="#D814171D"
                                                                            BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                                                                        <Path x:Name="AddIcon" Data="M 5,1.5 L 5,8.5 M 1.5,5 L 8.5,5"
                                                                              Width="9" Height="9" Stretch="Uniform"
                                                                              Stroke="{StaticResource Text}" StrokeThickness="1.7"
                                                                              StrokeStartLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="AddPill" Property="Background" Value="{StaticResource Accent}"/>
                                                                            <Setter TargetName="AddPill" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                                            <Setter TargetName="AddIcon" Property="Stroke" Value="{StaticResource AccentDark}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Asset.Name}" TextTrimming="CharacterEllipsis" FontWeight="Medium"
                                                       FontSize="11.5" Foreground="{StaticResource Text}" ToolTip="{Binding Asset.Path}" Margin="2,5,2,0"/>
                                            <TextBlock Text="{Binding Asset.MetaText}" Foreground="{StaticResource Muted}" FontSize="10" Margin="2,1,2,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button x:Name="AssetEmpty" Grid.Row="1" Margin="9,4,9,6" Click="ImportClick"
                                    Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    ToolTip="点击选择文件，或直接拖入本地视频、音频 · Ctrl+I"
                                    AutomationProperties.Name="导入或拖入本地素材">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="DropBg" BorderBrush="{StaticResource LineStrong}"
                                                BorderThickness="1" CornerRadius="8" Background="#101216">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DropBg" Property="Background" Value="#131A20"/>
                                                <Setter TargetName="DropBg" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="DropBg" Property="Background" Value="#17242C"/>
                                                <Setter TargetName="DropBg" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14">
                                    <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource AccentSubtle}"
                                            BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,11">
                                        <Path Data="M 2,5.5 L 8.5,5.5 L 10.5,8 L 21,8 L 21,18.5 L 2,18.5 Z M 11.5,10.5 L 11.5,15.5 M 9,13 L 14,13"
                                              Stroke="{StaticResource Accent}" StrokeThickness="1.55" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" Stretch="Uniform" Width="21" Height="18"/>
                                    </Border>
                                    <TextBlock x:Name="AssetEmptyTitle" Text="导入或拖入素材" HorizontalAlignment="Center"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                    <TextBlock x:Name="AssetEmptyHint" Text="点击导入，或直接拖入视频、图片、音频"
                                               Style="{StaticResource MutedText}" Margin="0,5,0,0" TextAlignment="Center"/>
                                    <Border x:Name="AssetEmptyKbd" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,10,0,0" HorizontalAlignment="Center">
                                        <TextBlock Text="Ctrl + I" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource Muted}"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Media Footer Actions -->
                            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="8,5">
                                <UniformGrid Rows="1">
                                    <Button x:Name="AppendButton" Content="加到主轨 V1" Click="AppendClick" IsEnabled="False"
                                            MinHeight="26" Padding="6,3" Margin="0,0,3,0"/>
                                    <Button x:Name="AddOverlayButton" Content="加为画中画 V2" Click="AddSelectedOverlayClick" IsEnabled="False"
                                            MinHeight="26" Padding="6,3" Margin="3,0,0,0"/>
                                </UniformGrid>
                            </Border>
                        </Grid>

                        <!-- TAB 2: LOCAL AUDIO BIN -->
                        <Grid Grid.Row="1" x:Name="AudioTabView" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Style="{StaticResource AccentSubtleButton}" Margin="9,7" Height="30"
                                    Click="ImportAudioClick" ToolTip="在播放头处导入并添加到独立音轨 A2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 5.5,1 L 5.5,10 M 1,5.5 L 10,5.5" Width="10" Height="10" Stretch="Uniform"
                                          Stroke="{StaticResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="导入本地音频并添加到 A2" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="9,2,9,10">
                                    <ItemsControl x:Name="AudioAssetList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                                        BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,0,0,6"
                                                        MouseRightButtonUp="AudioAssetRightClick" Tag="{Binding}">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                                                Padding="7,3" Content="＋ 入轨" Click="QuickAppendClick" Tag="{Binding}"
                                                                ToolTip="在播放头位置添加到 A2 独立音轨"/>
                                                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6"
                                                                Background="#172942" Margin="0,0,9,0">
                                                            <Path Data="M 2,8 L 2,12 M 5,5 L 5,15 M 8,3 L 8,17 M 11,6 L 11,14"
                                                                  Width="14" Height="13" Stretch="Uniform" Stroke="#5B9EF2"
                                                                  StrokeThickness="1.6" StrokeStartLineCap="Round"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Asset.Name}" FontSize="12" FontWeight="Medium"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Asset.DurationText}" FontFamily="Cascadia Mono, Consolas"
                                                                       FontSize="10" Foreground="{StaticResource Muted}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border x:Name="AudioEmptyHint" Background="#101216" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" CornerRadius="8" Padding="14,22" Margin="0,4,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="支持 WAV / MP3 / FLAC / M4A / AAC" HorizontalAlignment="Center"
                                                       FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="添加后可在时间线自由拖动、修剪，单击右侧可调音量与淡入淡出"
                                                       Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- TAB 3: LOCAL TEXT & PRESETS -->
                        <ScrollViewer Grid.Row="1" x:Name="TextTabView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,9,10,12">
                                <Button x:Name="AddDefaultTextBtn" Style="{StaticResource AccentSubtleButton}" Height="32"
                                        Click="AddTitleClick" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 5.5,1 L 5.5,10 M 1,5.5 L 10,5.5" Width="10" Height="10" Stretch="Uniform"
                                              Stroke="{StaticResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="在播放头添加默认文字" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="本地样式预设（点击添加或应用到选中文字）" Style="{StaticResource MutedText}" Margin="2,0,0,8"/>

                                <Button Style="{StaticResource TextPresetCard}" Tag="cinema" Click="TextPresetClick">
                                    <StackPanel>
                                        <Border Background="#0A0C10" CornerRadius="5" Height="44" Margin="0,0,0,6">
                                            <TextBlock Text="影院白字描边" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="4" Opacity="0.95"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="经典字幕 · 白色 44pt 细黑描边" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource TextPresetCard}" Tag="bar" Click="TextPresetClick">
                                    <StackPanel>
                                        <Border Background="#0A0C10" CornerRadius="5" Height="44" Margin="0,0,0,6">
                                            <Border Background="#CC000000" CornerRadius="4" Padding="10,3"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="黑底字幕条" FontSize="14.5" Foreground="#FFFFFF"/>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="高对比字幕 · 白色 + 半透明深黑底框" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource TextPresetCard}" Tag="headline" Click="TextPresetClick">
                                    <StackPanel>
                                        <Border Background="#0A0C10" CornerRadius="5" Height="44" Margin="0,0,0,6">
                                            <TextBlock Text="醒目标题" FontSize="18" FontWeight="Bold" Foreground="#FFE45E"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="居中大标题 · 暖黄 62pt 加粗描边" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource TextPresetCard}" Tag="accent" Click="TextPresetClick">
                                    <StackPanel>
                                        <Border Background="#0A0C10" CornerRadius="5" Height="44" Margin="0,0,0,6">
                                            <Border Background="#C80C1F26" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1"
                                                    CornerRadius="4" Padding="10,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="青色标注标签" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="画面标注 · 青色 36pt 深色底框" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Style="{StaticResource PaneDivider}" AutomationProperties.Name="调整素材区宽度"/>

                <!-- CENTER PANE: LIVE COMPOSITE CINEMA MONITOR & DIRECT CANVAS -->
                <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="46"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource PaneHeader}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton x:Name="CropModeToggle" Visibility="Collapsed" Click="CropModeToggleClick"
                                                  Margin="0,0,7,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                  ToolTip="在画布上直接拖动四边裁剪当前选中画面">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Cb" CornerRadius="5" Padding="8,3" Background="{StaticResource Raised}"
                                                        BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M 4,1 L 4,11 L 14,11 M 1,4 L 11,4 L 11,14" Width="11" Height="11"
                                                              Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.35"
                                                              Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="画布裁剪" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Cb" Property="Background" Value="{StaticResource AccentSubtle}"/>
                                                        <Setter TargetName="Cb" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <ToggleButton.Foreground>
                                            <SolidColorBrush Color="#A3A9B6"/>
                                        </ToggleButton.Foreground>
                                    </ToggleButton>

                                    <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="PreviewMode" Text="实时合成" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 1.5,2.5 L 13.5,2.5 L 13.5,11 L 1.5,11 Z M 5.5,13.5 L 9.5,13.5 M 7.5,11 L 7.5,13.5"
                                          Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource TextSecondary}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="播放器" Style="{StaticResource Section}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- True-Black Cinema Viewport with Live Multi-Layer Composition + Direct Manipulation -->
                        <Border Grid.Row="1" Background="{StaticResource Stage}" Padding="14,12">
                            <Grid x:Name="MonitorHost" ClipToBounds="True" SizeChanged="MonitorSizeChanged">
                                <Border x:Name="Picture" Background="#030405" BorderBrush="#1C2029" BorderThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                    <Grid>
                                        <!-- Logical 1080p-scaled live composite stack -->
                                        <Viewbox Stretch="Uniform">
                                            <Grid x:Name="CompositeStage" Width="1920" Height="1080" Background="#030405" ClipToBounds="True">
                                                <!-- Layer 0: V1 Main Video -->
                                                <Grid x:Name="MainVideoLayer" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform x:Name="MainVideoScale" ScaleX="1" ScaleY="1"/>
                                                            <RotateTransform x:Name="MainVideoRotate" Angle="0"/>
                                                            <TranslateTransform x:Name="MainVideoTranslate" X="0" Y="0"/>
                                                        </TransformGroup>
                                                    </Grid.RenderTransform>
                                                    <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close"
                                                                  Stretch="Uniform" ScrubbingEnabled="True"
                                                                  MediaOpened="PlayerOpened" MediaEnded="PlayerEnded" MediaFailed="PlayerFailed"/>
                                                    <Image x:Name="MainImageLayer" Stretch="Uniform" Visibility="Collapsed"/>
                                                </Grid>

                                                <!-- Layer 1: V2 Picture-in-Picture Video -->
                                                <Grid x:Name="OverlayVideoLayer" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform x:Name="OverlayVideoScale" ScaleX="0.45" ScaleY="0.45"/>
                                                            <RotateTransform x:Name="OverlayVideoRotate" Angle="0"/>
                                                            <TranslateTransform x:Name="OverlayVideoTranslate" X="0" Y="0"/>
                                                        </TransformGroup>
                                                    </Grid.RenderTransform>
                                                    <MediaElement x:Name="OverlayPlayer" LoadedBehavior="Manual" UnloadedBehavior="Close"
                                                                  Stretch="Uniform" ScrubbingEnabled="True"
                                                                  MediaOpened="OverlayPlayerOpened"/>
                                                    <Image x:Name="OverlayImageLayer" Stretch="Uniform" Visibility="Collapsed"/>
                                                </Grid>

                                                <!-- Layer 2: Live Styled Titles -->
                                                <Canvas x:Name="LiveTitleCanvas" IsHitTestVisible="False"/>
                                            </Grid>
                                        </Viewbox>

                                        <!-- Screen-space razor-sharp Interactive Adorner Layer (Handles, Snap Guides, Crop Mask) -->
                                        <Canvas x:Name="CanvasAdorner" Background="Transparent"
                                                MouseLeftButtonDown="CanvasMouseDown"
                                                MouseMove="CanvasMouseMove"
                                                MouseLeftButtonUp="CanvasMouseUp"/>

                                        <!-- Empty / Loading Hint -->
                                        <StackPanel x:Name="PreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Margin="14" IsHitTestVisible="False">
                                            <Border Width="48" Height="48" CornerRadius="14" Background="#12151B"
                                                    BorderBrush="#222631" BorderThickness="1" HorizontalAlignment="Center">
                                                <Path Width="19" Height="17" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.5"
                                                      StrokeLineJoin="Round" Data="M 1.5,2 L 21.5,2 L 21.5,16.5 L 1.5,16.5 Z M 9.5,6.2 L 15,9.25 L 9.5,12.3 Z"/>
                                            </Border>
                                            <TextBlock x:Name="PreviewMessage" Text="把视频加入时间线后即可预览" Margin="0,12,0,0"
                                                       TextAlignment="Center" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Floating Interactive Crop Mode Banner -->
                                <Border x:Name="CropBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Margin="0,6,0,0" Background="#E6151921" BorderBrush="{StaticResource AccentBorder}"
                                        BorderThickness="1" CornerRadius="14" Padding="12,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="裁剪模式 · 拖动青色边线调整保留区域" FontSize="11.5"
                                                   Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Style="{StaticResource GhostButton}" Content="重置" Padding="7,2" MinHeight="22"
                                                Click="ResetCropClick" Margin="0,0,4,0"/>
                                        <Button Style="{StaticResource Primary}" Content="完成" Padding="9,2" MinHeight="22"
                                                Click="ExitCropModeClick"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Transport Deck -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                BorderThickness="0,1,0,0" CornerRadius="0,0,6,6" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="168"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="CurrentTime" Text="00:00:00.000" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TotalTime" Text=" / 00:00:00.000" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" Width="30" Height="28" Padding="0"
                                            Click="StartClick" AutomationProperties.Name="回到起点" ToolTip="回到起点 · Home">
                                        <Path Data="M 2.5,2 L 2.5,11 M 10.5,2.5 L 4.5,6.5 L 10.5,10.5 Z" Width="11" Height="11" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                    </Button>
                                    <Button x:Name="PlayButton" Style="{StaticResource TransportPlayButton}" Margin="8,0"
                                            Click="PlayClick" AutomationProperties.Name="播放或暂停" ToolTip="播放 / 暂停 · 空格">
                                        <Grid Width="12" Height="12">
                                            <Path x:Name="PlayIcon" Data="M 2.5,1.2 L 10.8,6 L 2.5,10.8 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <Path x:Name="PauseIcon" Data="M 2.2,1.5 L 4.8,1.5 L 4.8,10.5 L 2.2,10.5 Z M 7.2,1.5 L 9.8,1.5 L 9.8,10.5 L 7.2,10.5 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Width="30" Height="28" Padding="0"
                                            Click="EndClick" AutomationProperties.Name="跳到结尾" ToolTip="跳到结尾 · End">
                                        <Path Data="M 10.5,2 L 10.5,11 M 2.5,2.5 L 8.5,6.5 L 2.5,10.5 Z" Width="11" Height="11" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="StillFrameButton" Style="{StaticResource GhostButton}" Width="28" Height="27" Padding="0"
                                            Margin="0,0,8,0" Click="ExportStillFrameClick" IsEnabled="False"
                                            AutomationProperties.Name="导出当前静帧" ToolTip="导出当前静帧画面（PNG / JPG）">
                                        <Path Data="M 1.5,4 L 4.2,4 L 5.6,2 L 9.4,2 L 10.8,4 L 13.5,4 L 13.5,12 L 1.5,12 Z M 7.5,5.5 A 2.4,2.4 0 1 0 7.5,10.3 A 2.4,2.4 0 1 0 7.5,5.5 Z"
                                              Width="13.5" Height="12" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.3" StrokeLineJoin="Round"/>
                                    </Button>
                                    <TextBlock Text="画幅" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <ComboBox x:Name="AspectBox" Width="74" Height="27" VerticalAlignment="Center"
                                              SelectionChanged="AspectChanged" AutomationProperties.Name="画幅" ToolTip="预览与导出画幅">
                                        <ComboBoxItem Content="16:9"/>
                                        <ComboBoxItem Content="9:16"/>
                                        <ComboBoxItem Content="1:1"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Style="{StaticResource PaneDivider}" AutomationProperties.Name="调整属性区宽度"/>

                <!-- RIGHT PANE: POLYMORPHIC CONTEXT INSPECTOR -->
                <Border Grid.Column="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource PaneHeader}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 2,4 L 13,4 M 2,10 L 13,10 M 5.5,2.2 L 5.5,5.8 M 9.5,8.2 L 9.5,11.8"
                                      Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource TextSecondary}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="InspectorTitle" Text="项目参数" Style="{StaticResource Section}"/>
                            </StackPanel>
                        </Border>

                        <!-- 1. Project Overview (No Selection) -->
                        <ScrollViewer Grid.Row="1" x:Name="InspectEmpty" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="9,9,9,10">
                                <Border Style="{StaticResource InspectorCard}">
                                    <StackPanel>
                                        <TextBlock Text="当前项目" Style="{StaticResource CardTitle}" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="ProjectInspectorName" Text="未命名项目" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="7"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Background="{StaticResource Background}" CornerRadius="5" Padding="8,5">
                                                <StackPanel>
                                                    <TextBlock Text="画幅比例" FontSize="10" Foreground="{StaticResource Muted}"/>
                                                    <TextBlock x:Name="ProjectInspectorFormat" Text="16:9" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{StaticResource Background}" CornerRadius="5" Padding="8,5">
                                                <StackPanel>
                                                    <TextBlock Text="项目总时长" FontSize="10" Foreground="{StaticResource Muted}"/>
                                                    <TextBlock x:Name="ProjectInspectorDuration" Text="00:00:00" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="2" Background="{StaticResource Background}" CornerRadius="5" Padding="8,5">
                                                <StackPanel>
                                                    <TextBlock Text="本地素材" FontSize="10" Foreground="{StaticResource Muted}"/>
                                                    <TextBlock x:Name="ProjectInspectorAssets" Text="0 项" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource Background}" CornerRadius="5" Padding="8,5">
                                                <StackPanel>
                                                    <TextBlock Text="轨道片段" FontSize="10" Foreground="{StaticResource Muted}"/>
                                                    <TextBlock x:Name="ProjectInspectorClips" Text="0 段" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource InspectorCard}">
                                    <StackPanel>
                                        <TextBlock Text="常用快捷键" Style="{StaticResource CardTitle}" Margin="0,0,0,7"/>
                                        <DockPanel Margin="0,0,0,5">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource KbdBadge}"><TextBlock Text="Space" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource TextSecondary}"/></Border>
                                            <TextBlock Text="播放 / 暂停" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,5">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource KbdBadge}"><TextBlock Text="Ctrl + B" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource TextSecondary}"/></Border>
                                            <TextBlock Text="在播放头分割" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,5">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource KbdBadge}"><TextBlock Text="Ctrl + Z / Y" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource TextSecondary}"/></Border>
                                            <TextBlock Text="撤销 / 重做" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource KbdBadge}"><TextBlock Text="Ctrl + 滚轮" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource TextSecondary}"/></Border>
                                            <TextBlock Text="缩放时间线" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="单击任意轨道的片段（主轨、画中画、文字、音频），即可在此直接调参并在画布上实时预览与拖拽。"
                                           Style="{StaticResource MutedText}" Margin="3,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 2. Video / PiP Clip Inspector -->
                        <ScrollViewer Grid.Row="1" x:Name="InspectorVideoScroll" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Inspector" Margin="8,8,8,10">
                                <!-- Clip Identity -->
                                <Border Style="{StaticResource InspectorCard}" Padding="10,7">
                                    <DockPanel>
                                        <Border x:Name="ClipTrackPill" DockPanel.Dock="Right" Background="{StaticResource AccentSubtle}"
                                                BorderBrush="{StaticResource AccentBorder}" BorderThickness="1"
                                                CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock x:Name="ClipTrackLabel" Text="V1 主轨" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock x:Name="ClipName" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="ClipDetail" Style="{StaticResource MutedText}" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="10.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Canvas Transform Card -->
                                <Border Style="{StaticResource InspectorCard}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,5">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="重置"
                                                    Padding="6,1" MinHeight="20" FontSize="10.5" Click="ResetTransformClick"/>
                                            <TextBlock Text="画面变换" Style="{StaticResource CardTitle}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,2,0,1">
                                            <TextBlock x:Name="ScaleValueText" DockPanel.Dock="Right" Text="100%" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="10.5" Foreground="{StaticResource Accent}"/>
                                            <TextBlock Text="缩放" FontSize="11" Foreground="{StaticResource Muted}"/>
                                        </DockPanel>
                                        <Slider x:Name="ScaleSlider" Minimum="10" Maximum="300" Value="100"
                                                ValueChanged="TransformSliderChanged" PreviewMouseUp="TransformSliderCommit"/>

                                        <DockPanel Margin="0,2,0,1">
                                            <TextBlock x:Name="RotateValueText" DockPanel.Dock="Right" Text="0°" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="旋转" FontSize="11" Foreground="{StaticResource Muted}"/>
                                        </DockPanel>
                                        <Slider x:Name="RotateSlider" Minimum="-180" Maximum="180" Value="0"
                                                ValueChanged="TransformSliderChanged" PreviewMouseUp="TransformSliderCommit"/>

                                        <DockPanel Margin="0,2,0,1">
                                            <TextBlock x:Name="OpacityValueText" DockPanel.Dock="Right" Text="100%" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="不透明度" FontSize="11" Foreground="{StaticResource Muted}"/>
                                        </DockPanel>
                                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100"
                                                ValueChanged="TransformSliderChanged" PreviewMouseUp="TransformSliderCommit"/>

                                        <TextBlock x:Name="PositionReadout" Text="位置 X 0%  ·  Y 0%（可在画布直接拖动）"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Visual Crop Card -->
                                <Border Style="{StaticResource InspectorCard}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock x:Name="CropBadge" DockPanel.Dock="Right" Text="未裁剪" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="画面裁剪" Style="{StaticResource CardTitle}"/>
                                        </DockPanel>
                                        <UniformGrid Rows="1">
                                            <Button x:Name="CanvasCropBtn" Style="{StaticResource AccentSubtleButton}" Content="画布直裁"
                                                    MinHeight="26" Padding="6,3" Margin="0,0,4,0" Click="EnterCropModeClick"/>
                                            <Button x:Name="CropButton" Content="精确数值…" MinHeight="26" Padding="6,3" Margin="2,0,2,0" Click="CropClick"/>
                                            <Button Content="重置" MinHeight="26" Padding="6,3" Margin="4,0,0,0" Click="ResetCropClick"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Trim Range Card -->
                                <Border Style="{StaticResource InspectorCard}">
                                    <StackPanel>
                                        <TextBlock Text="修剪与时间" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                                        <StackPanel x:Name="OverlayStartRow" Visibility="Collapsed" Margin="0,0,0,6">
                                            <TextBlock Text="时间线起点" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3"/>
                                            <TextBox x:Name="OverlayStartBox" FontFamily="Cascadia Mono, Consolas" FontSize="11" MinHeight="26" Padding="7,3"
                                                     KeyDown="TrimTextKeyDown"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="入点" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3"/>
                                                <TextBox x:Name="InBox" FontFamily="Cascadia Mono, Consolas" FontSize="11" MinHeight="26" Padding="7,3"
                                                         AutomationProperties.Name="片段入点" KeyDown="TrimTextKeyDown"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="出点" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3"/>
                                                <TextBox x:Name="OutBox" FontFamily="Cascadia Mono, Consolas" FontSize="11" MinHeight="26" Padding="7,3"
                                                         AutomationProperties.Name="片段出点" KeyDown="TrimTextKeyDown"/>
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="应用时间范围" Click="ApplyTrimClick" Margin="0,7,0,0" MinHeight="26" Padding="10,3"/>
                                    </StackPanel>
                                </Border>

                                <!-- Audio Card -->
                                <Border Style="{StaticResource InspectorCard}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <Border DockPanel.Dock="Right" Background="{StaticResource Background}" CornerRadius="4" Padding="6,1">
                                                <TextBlock x:Name="VolumeValue" Text="100%" FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                            </Border>
                                            <TextBlock Text="原声电平" Style="{StaticResource CardTitle}"/>
                                        </DockPanel>
                                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="200" Value="100" TickFrequency="5"
                                                IsSnapToTickEnabled="True" ValueChanged="VolumeChanged" PreviewMouseUp="VolumeCommit"
                                                KeyUp="VolumeKeyUp" LostKeyboardFocus="VolumeLostFocus" AutomationProperties.Name="原声音量" Margin="0,0,0,6"/>
                                        <Button x:Name="SeparateButton" Style="{StaticResource InspectorActionRow}" Padding="9,5" Click="SeparateClick">
                                            <DockPanel>
                                                <Path DockPanel.Dock="Left" Data="M 2,8 L 2,11 M 5,5 L 5,14 M 8,3 L 8,16 M 11,6 L 11,13"
                                                      Width="12" Height="11" Stretch="Uniform" Stroke="{StaticResource TrackMusicTag}"
                                                      StrokeThickness="1.5" StrokeStartLineCap="Round" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="分离为独立音轨" FontSize="11.5" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Inline Cross-Dissolve Card (Main Track V1 only) -->
                                <Border x:Name="DissolveCard" Style="{StaticResource InspectorCard}" Margin="0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <Border DockPanel.Dock="Right" Background="{StaticResource Background}" CornerRadius="4" Padding="6,1">
                                                <TextBlock x:Name="DissolveBadge" Text="无" FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="10.5" Foreground="{StaticResource Muted}"/>
                                            </Border>
                                            <TextBlock Text="与下一段叠化" Style="{StaticResource CardTitle}"/>
                                        </DockPanel>
                                        <Slider x:Name="DissolveSlider" Minimum="0" Maximum="2" Value="0" TickFrequency="0.1"
                                                IsSnapToTickEnabled="True" ValueChanged="DissolveSliderChanged" PreviewMouseUp="DissolveSliderCommit"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 3. Title Inspector (Direct Inline Editing - No Modal Needed!) -->
                        <ScrollViewer Grid.Row="1" x:Name="InspectorTitleScroll" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8,8,8,10">
                                <Border Style="{StaticResource InspectorCard}" Padding="10,7">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostDangerButton}" Content="删除"
                                                Padding="8,2" MinHeight="22" Click="DeleteClick"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#43291E" BorderBrush="{StaticResource TrackTextTag}" BorderThickness="1"
                                                    CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                                                <TextBlock Text="T1 文字" FontFamily="Cascadia Mono, Consolas" FontSize="9.5"
                                                           FontWeight="SemiBold" Foreground="#F6C5AC"/>
                                            </Border>
                                            <TextBlock Text="实时排版" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource InspectorCard}">
                                    <StackPanel>
                                        <TextBlock Text="文字内容（实时同步画布）" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TitleTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" MaxHeight="110"
                                                 VerticalContentAlignment="Top" Padding="8,6" TextChanged="TitleTextLiveChanged"
                                                 LostKeyboardFocus="TitleStyleCommit"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource InspectorCard}">
                                    <StackPanel>
                                        <TextBlock Text="字体与外观" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="TitleFontBox" Height="29" SelectionChanged="TitleStyleControlChanged" Margin="0,0,0,8">
                                            <ComboBoxItem Content="Microsoft YaHei UI"/>
                                            <ComboBoxItem Content="SimHei"/>
                                            <ComboBoxItem Content="SimSun"/>
                                            <ComboBoxItem Content="KaiTi"/>
                                            <ComboBoxItem Content="Segoe UI"/>
                                        </ComboBox>

                                        <DockPanel Margin="0,0,0,1">
                                            <TextBlock x:Name="TitleSizeValue" DockPanel.Dock="Right" Text="44 pt" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="10.5" Foreground="{StaticResource Accent}"/>
                                            <TextBlock Text="字号" FontSize="11" Foreground="{StaticResource Muted}"/>
                                        </DockPanel>
                                        <Slider x:Name="TitleSizeSlider" Minimum="18" Maximum="110" Value="44"
                                                ValueChanged="TitleSizeLiveChanged" PreviewMouseUp="TitleStyleCommit" Margin="0,0,0,8"/>

                                        <TextBlock Text="文字颜色" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                            <Button Style="{StaticResource ColorDot}" Background="#FFFFFF" Tag="#FFFFFF" Click="TitleColorClick" ToolTip="纯白"/>
                                            <Button Style="{StaticResource ColorDot}" Background="#FFE45E" Tag="#FFE45E" Click="TitleColorClick" ToolTip="暖黄"/>
                                            <Button Style="{StaticResource ColorDot}" Background="#18D2E6" Tag="#18D2E6" Click="TitleColorClick" ToolTip="青色"/>
                                            <Button Style="{StaticResource ColorDot}" Background="#FF7875" Tag="#FF7875" Click="TitleColorClick" ToolTip="珊瑚红"/>
                                            <Button Style="{StaticResource ColorDot}" Background="#111216" Tag="#111216" Click="TitleColorClick" ToolTip="深黑"/>
                                        </StackPanel>

                                        <CheckBox x:Name="TitleOutlineCheck" Content="文字描边" IsChecked="True" Margin="0,0,0,6"
                                                  Checked="TitleStyleControlChanged" Unchecked="TitleStyleControlChanged"/>
                                        <CheckBox x:Name="TitleBgCheck" Content="半透明黑底字幕条" IsChecked="False"
                                                  Checked="TitleStyleControlChanged" Unchecked="TitleStyleControlChanged"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource InspectorCard}" Margin="0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="居中复位"
                                                    Padding="6,1" MinHeight="20" FontSize="10.5" Click="ResetTitlePosClick"/>
                                            <TextBlock Text="时间与位置" Style="{StaticResource CardTitle}"/>
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="起点(秒)" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TitleStartBox" FontFamily="Cascadia Mono, Consolas" FontSize="11" MinHeight="26" Padding="7,3" KeyDown="TitleTimeKeyDown"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="时长(秒)" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TitleDurBox" FontFamily="Cascadia Mono, Consolas" FontSize="11" MinHeight="26" Padding="7,3" KeyDown="TitleTimeKeyDown"/>
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="应用时间" Click="ApplyTitleTimeClick" Margin="0,7,0,0" MinHeight="26"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 4. Detached Audio Inspector -->
                        <ScrollViewer Grid.Row="1" x:Name="InspectorAudioScroll" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8,8,8,10">
                                <Border Style="{StaticResource InspectorCard}" Padding="10,7">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostDangerButton}" Content="删除"
                                                Padding="8,2" MinHeight="22" Click="DeleteClick"/>
                                        <StackPanel>
                                            <TextBlock x:Name="AudioClipName" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="A2 独立音轨" FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                                       Foreground="{StaticResource TrackMusicTag}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource InspectorCard}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <Border DockPanel.Dock="Right" Background="{StaticResource Background}" CornerRadius="4" Padding="6,1">
                                                <TextBlock x:Name="AudioVolumeValue" Text="100%" FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                            </Border>
                                            <TextBlock Text="音频电平" Style="{StaticResource CardTitle}"/>
                                        </DockPanel>
                                        <Slider x:Name="AudioVolumeSlider" Minimum="0" Maximum="200" Value="100" TickFrequency="5"
                                                IsSnapToTickEnabled="True" ValueChanged="AudioVolumeLiveChanged" PreviewMouseUp="AudioVolumeCommit"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="淡入(秒)" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3"/>
                                                <TextBox x:Name="AudioFadeInBox" FontFamily="Cascadia Mono, Consolas" FontSize="11" MinHeight="26" Padding="7,3" KeyDown="AudioTimeKeyDown"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="淡出(秒)" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3"/>
                                                <TextBox x:Name="AudioFadeOutBox" FontFamily="Cascadia Mono, Consolas" FontSize="11" MinHeight="26" Padding="7,3" KeyDown="AudioTimeKeyDown"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource InspectorCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="时间与裁剪" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                                        <TextBlock Text="时间线起点" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="AudioStartBox" FontFamily="Cascadia Mono, Consolas" FontSize="11" MinHeight="26" Padding="7,3" Margin="0,0,0,6" KeyDown="AudioTimeKeyDown"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="素材入点" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3"/>
                                                <TextBox x:Name="AudioInBox" FontFamily="Cascadia Mono, Consolas" FontSize="11" MinHeight="26" Padding="7,3" KeyDown="AudioTimeKeyDown"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="素材出点" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3"/>
                                                <TextBox x:Name="AudioOutBox" FontFamily="Cascadia Mono, Consolas" FontSize="11" MinHeight="26" Padding="7,3" KeyDown="AudioTimeKeyDown"/>
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="应用音频参数" Click="ApplyAudioParamsClick" Margin="0,8,0,0" MinHeight="26"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="2" Margin="4,0" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ResizeBehavior="PreviousAndNext" Style="{StaticResource PaneDivider}" AutomationProperties.Name="调整时间线高度"/>

            <!-- BOTTOM PANE: MULTI-TRACK PRO TIMELINE -->
            <Border Grid.Row="3" Margin="4,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Timeline Toolbar -->
                    <Border Style="{StaticResource PaneHeader}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Width="24" Height="24" Padding="0" Click="ZoomOutClick" ToolTip="缩小时间线">
                                    <Path Data="M 2,6 L 10,6" Width="10" Height="10" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round"/>
                                </Button>
                                <Slider x:Name="ZoomSlider" Minimum="-4" Maximum="4" Value="0" Width="96" Margin="2,0"
                                        VerticalAlignment="Center" ValueChanged="ZoomChanged" AutomationProperties.Name="时间线缩放"/>
                                <Button Style="{StaticResource GhostButton}" Width="24" Height="24" Padding="0" Click="ZoomInClick" ToolTip="放大时间线">
                                    <Path Data="M 6,2 L 6,10 M 2,6 L 10,6" Width="10" Height="10" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round"/>
                                </Button>
                                <Border Style="{StaticResource ToolbarDivider}"/>
                                <Button Style="{StaticResource GhostButton}" Click="FitClick" ToolTip="让所有片段适合窗口宽度">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 1.5,5 L 1.5,1.5 L 5,1.5 M 10,1.5 L 13.5,1.5 L 13.5,5 M 1.5,10 L 1.5,13.5 L 5,13.5 M 10,13.5 L 13.5,13.5 L 13.5,10"
                                              Width="11.5" Height="11.5" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.35" StrokeStartLineCap="Round" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="适应" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UndoButton" Style="{StaticResource GhostButton}" Width="27" Height="25" Padding="0"
                                        Click="UndoClick" AutomationProperties.Name="撤销" ToolTip="撤销 · Ctrl+Z">
                                    <Path Data="M 5.5,3 L 2,6.5 L 5.5,10 M 2.5,6.5 L 9.5,6.5 A 3.5,3.5 0 0 1 9.5,13.5 L 6,13.5"
                                          Width="12.5" Height="12.5" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                </Button>
                                <Button x:Name="RedoButton" Style="{StaticResource GhostButton}" Width="27" Height="25" Padding="0"
                                        Click="RedoClick" AutomationProperties.Name="重做" ToolTip="重做 · Ctrl+Y">
                                    <Path Data="M 9.5,3 L 13,6.5 L 9.5,10 M 12.5,6.5 L 5.5,6.5 A 3.5,3.5 0 0 0 5.5,13.5 L 9,13.5"
                                          Width="12.5" Height="12.5" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                </Button>

                                <Border Style="{StaticResource ToolbarDivider}"/>

                                <Button x:Name="SplitButton" Style="{StaticResource GhostButton}" Click="SplitClick" ToolTip="在播放头分割 · Ctrl+B">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 4,2 L 4,14 M 1,5 L 4,8 L 1,11 M 10,2 L 10,14 M 13,5 L 10,8 L 13,11"
                                              Width="12.5" Height="12.5" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.35" StrokeStartLineCap="Round" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="分割" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DuplicateButton" Style="{StaticResource GhostButton}" Click="DuplicateClick" ToolTip="复制选中片段 · Ctrl+D">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 4.5,4.5 L 12.5,4.5 L 12.5,12.5 L 4.5,12.5 Z M 2,9.5 L 2,2 L 9.5,2"
                                              Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.3" StrokeLineJoin="Round" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="复制" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DeleteButton" Style="{StaticResource GhostDangerButton}" Click="DeleteClick" ToolTip="删除选中项 · Delete">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 2.5,4 L 12.5,4 M 5.5,2 L 9.5,2 M 4,4 L 4.6,13 L 10.4,13 L 11,4"
                                              Width="11.5" Height="11.5" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.35" StrokeStartLineCap="Round" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="删除" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Border Style="{StaticResource ToolbarDivider}"/>

                                <Button x:Name="LeftButton" Style="{StaticResource GhostButton}" Width="26" Height="25" Padding="0"
                                        Click="LeftClick" AutomationProperties.Name="前移片段" ToolTip="前移主轨片段">
                                    <Path Data="M 9,2.5 L 4,7 L 9,11.5" Width="10.5" Height="10.5" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                                </Button>
                                <Button x:Name="RightButton" Style="{StaticResource GhostButton}" Width="26" Height="25" Padding="0"
                                        Click="RightClick" AutomationProperties.Name="后移片段" ToolTip="后移主轨片段">
                                    <Path Data="M 5,2.5 L 10,7 L 5,11.5" Width="10.5" Height="10.5" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                                </Button>

                                <Border Style="{StaticResource ToolbarDivider}"/>

                                <Button x:Name="TitleButton" Style="{StaticResource GhostButton}" Click="AddTitleClick" ToolTip="在播放头添加文字">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" CornerRadius="3" Background="#4A2D20"
                                                BorderBrush="{StaticResource TrackTextTag}" BorderThickness="1" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <TextBlock Text="T" FontSize="9" FontWeight="Bold" Foreground="#F6C5AC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="文字" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AudioButton" Style="{StaticResource GhostButton}" Click="ImportAudioClick" Margin="2,0,0,0" ToolTip="在播放头导入本地音频">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" CornerRadius="3" Background="#172A44"
                                                BorderBrush="{StaticResource TrackMusicTag}" BorderThickness="1" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Path Data="M 2,6 L 2,9 M 5,3.5 L 5,11.5 M 8,5 L 8,10" Width="8" Height="8" Stretch="Uniform"
                                                  Stroke="#7AB4FA" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                                        </Border>
                                        <TextBlock Text="音频" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Pixel-Aligned Track Headers (142px) + Multi-Track TimelineView -->
                    <Grid Grid.Row="1" Background="#0F1115" ClipToBounds="True"
                          DragOver="TimelineDragOver" DragLeave="TimelineDragLeave" Drop="TimelineDrop"
                          PreviewMouseWheel="TimelineMouseWheel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="142"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Track Headers: EXACT heights 30 / 52 / 66 / 34 / 32 / 34 matching TimelineView.cs -->
                        <Border Background="#13151A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="52"/>
                                    <RowDefinition Height="66"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Ruler Header -->
                                <Border Grid.Row="0" BorderBrush="#1E212A" BorderThickness="0,0,0,1" Padding="10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 6,1.5 A 4.5,4.5 0 1 0 6,10.5 A 4.5,4.5 0 1 0 6,1.5 Z M 6,3.5 L 6,6 L 8,7.2"
                                              Width="11" Height="11" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.3" Margin="0,0,6,0"/>
                                        <TextBlock Text="时间标尺" FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- V2 PiP Overlay Header -->
                                <Border Grid.Row="1" BorderBrush="#1E212A" BorderThickness="0,0,0,1" Padding="7,0,6,0">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton x:Name="V2HideBtn" Style="{StaticResource TrackToggle}" Tag="V2:Hidden" Click="TrackFlagClick" ToolTip="隐藏/显示画中画轨">
                                                <Path Data="M 1,6 C 3,2.5 9,2.5 11,6 C 9,9.5 3,9.5 1,6 Z M 6,4.3 A 1.7,1.7 0 1 0 6,7.7 A 1.7,1.7 0 1 0 6,4.3 Z"
                                                      Width="11.5" Height="9" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2"/>
                                            </ToggleButton>
                                            <ToggleButton x:Name="V2MuteBtn" Style="{StaticResource TrackToggle}" Tag="V2:Muted" Click="TrackFlagClick" ToolTip="静音画中画音轨">
                                                <Path Data="M 2,5 L 4.5,5 L 7.5,2.5 L 7.5,11.5 L 4.5,9 L 2,9 Z M 9.5,5 L 12,9 M 12,5 L 9.5,9"
                                                      Width="11" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" StrokeStartLineCap="Round"/>
                                            </ToggleButton>
                                            <ToggleButton x:Name="V2LockBtn" Style="{StaticResource TrackToggle}" Tag="V2:Locked" Click="TrackFlagClick" ToolTip="锁定画中画轨">
                                                <Path Data="M 3,5.5 L 3,3.8 A 2.5,2.5 0 0 1 8,3.8 L 8,5.5 M 2,5.5 L 9,5.5 L 9,10.5 L 2,10.5 Z"
                                                      Width="9.5" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2"/>
                                            </ToggleButton>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="22" CornerRadius="1.5" Background="{StaticResource TrackOverlayTag}" Margin="0,0,7,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="V2" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TrackOverlayTag}"/>
                                                <TextBlock Text="画中画" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- V1 Main Video Header -->
                                <Border Grid.Row="2" BorderBrush="#1E212A" BorderThickness="0,0,0,1" Padding="7,0,6,0">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton x:Name="V1HideBtn" Style="{StaticResource TrackToggle}" Tag="V1:Hidden" Click="TrackFlagClick" ToolTip="隐藏/显示主视频轨">
                                                <Path Data="M 1,6 C 3,2.5 9,2.5 11,6 C 9,9.5 3,9.5 1,6 Z M 6,4.3 A 1.7,1.7 0 1 0 6,7.7 A 1.7,1.7 0 1 0 6,4.3 Z"
                                                      Width="11.5" Height="9" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2"/>
                                            </ToggleButton>
                                            <ToggleButton x:Name="V1LockBtn" Style="{StaticResource TrackToggle}" Tag="V1:Locked" Click="TrackFlagClick" ToolTip="锁定主视频轨">
                                                <Path Data="M 3,5.5 L 3,3.8 A 2.5,2.5 0 0 1 8,3.8 L 8,5.5 M 2,5.5 L 9,5.5 L 9,10.5 L 2,10.5 Z"
                                                      Width="9.5" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2"/>
                                            </ToggleButton>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="28" CornerRadius="1.5" Background="{StaticResource TrackVideoTag}" Margin="0,0,7,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="V1" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TrackVideoTag}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="主视频" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                                </StackPanel>
                                                <TextBlock Text="磁吸主轨" FontSize="9.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- A1 Original Audio Header -->
                                <Border Grid.Row="3" BorderBrush="#1E212A" BorderThickness="0,0,0,1" Padding="7,0,6,0">
                                    <DockPanel>
                                        <ToggleButton x:Name="A1MuteBtn" DockPanel.Dock="Right" Style="{StaticResource TrackToggle}" Tag="A1:Muted" Click="TrackFlagClick" ToolTip="静音主轨原声">
                                            <Path Data="M 2,5 L 4.5,5 L 7.5,2.5 L 7.5,11.5 L 4.5,9 L 2,9 Z M 9.5,5 L 12,9 M 12,5 L 9.5,9"
                                                  Width="11" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" StrokeStartLineCap="Round"/>
                                        </ToggleButton>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="15" CornerRadius="1.5" Background="{StaticResource TrackAudioTag}" Margin="0,0,7,0"/>
                                            <TextBlock Text="A1" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TrackAudioTag}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="原声" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- T1 Title Header -->
                                <Border Grid.Row="4" BorderBrush="#1E212A" BorderThickness="0,0,0,1" Padding="7,0,6,0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton x:Name="T1HideBtn" Style="{StaticResource TrackToggle}" Tag="T1:Hidden" Click="TrackFlagClick" ToolTip="隐藏/显示文字轨">
                                                <Path Data="M 1,6 C 3,2.5 9,2.5 11,6 C 9,9.5 3,9.5 1,6 Z M 6,4.3 A 1.7,1.7 0 1 0 6,7.7 A 1.7,1.7 0 1 0 6,4.3 Z"
                                                      Width="11.5" Height="9" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2"/>
                                            </ToggleButton>
                                            <ToggleButton x:Name="T1LockBtn" Style="{StaticResource TrackToggle}" Tag="T1:Locked" Click="TrackFlagClick" ToolTip="锁定文字轨">
                                                <Path Data="M 3,5.5 L 3,3.8 A 2.5,2.5 0 0 1 8,3.8 L 8,5.5 M 2,5.5 L 9,5.5 L 9,10.5 L 2,10.5 Z"
                                                      Width="9.5" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2"/>
                                            </ToggleButton>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource TrackTextTag}" Margin="0,0,7,0"/>
                                            <TextBlock Text="T1" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TrackTextTag}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="文字" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- A2 Detached Audio Header -->
                                <Border Grid.Row="5" BorderBrush="#1E212A" BorderThickness="0,0,0,1" Padding="7,0,6,0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton x:Name="A2MuteBtn" Style="{StaticResource TrackToggle}" Tag="A2:Muted" Click="TrackFlagClick" ToolTip="静音独立音轨">
                                                <Path Data="M 2,5 L 4.5,5 L 7.5,2.5 L 7.5,11.5 L 4.5,9 L 2,9 Z M 9.5,5 L 12,9 M 12,5 L 9.5,9"
                                                      Width="11" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" StrokeStartLineCap="Round"/>
                                            </ToggleButton>
                                            <ToggleButton x:Name="A2LockBtn" Style="{StaticResource TrackToggle}" Tag="A2:Locked" Click="TrackFlagClick" ToolTip="锁定独立音轨">
                                                <Path Data="M 3,5.5 L 3,3.8 A 2.5,2.5 0 0 1 8,3.8 L 8,5.5 M 2,5.5 L 9,5.5 L 9,10.5 L 2,10.5 Z"
                                                      Width="9.5" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2"/>
                                            </ToggleButton>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="15" CornerRadius="1.5" Background="{StaticResource TrackMusicTag}" Margin="0,0,7,0"/>
                                            <TextBlock Text="A2" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TrackMusicTag}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="音轨" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Scrollable Timeline Canvas -->
                        <ScrollViewer x:Name="TimelineScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" SizeChanged="TimelineSizeChanged"
                                      ScrollChanged="TimelineScrolled" PanningMode="None">
                            <local:TimelineView x:Name="Timeline" Focusable="True" FocusVisualStyle="{x:Null}"
                                                AutomationProperties.Name="视频时间线"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- TELEMETRY STATUS BAR -->
            <Border Grid.Row="4" Background="#0E1013" BorderBrush="#1C1F27" BorderThickness="0,1,0,0" Padding="12,0">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="StatusMeta" DockPanel.Dock="Right" Text="0 个片段" FontSize="11"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5.5" Height="5.5" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Status" Text="就绪" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- LAUNCHER HOME SCREEN (Zero-bloat start screen: Split Hero + Local Drafts) -->
            <Border Grid.Row="1" Grid.RowSpan="4" x:Name="HomeScreen" Background="{StaticResource Canvas}" Panel.ZIndex="2" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MaxWidth="1120" Margin="44,32,44,36">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Split Hero Banner: Left = 开始创作 | Right = 图片格式转换 -->
                        <Grid Height="156">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Hero 1: Start Video Editing -->
                            <Button x:Name="HomeStartEditBtn" Click="HomeStartEditClick" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    AutomationProperties.Name="开始创作">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="HeroBg" CornerRadius="14" BorderThickness="1" BorderBrush="#235766" SnapsToDevicePixels="True">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#142C36" Offset="0"/>
                                                    <GradientStop Color="#0D3A47" Offset="0.55"/>
                                                    <GradientStop Color="#0D1E27" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeroBg" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                <Setter TargetName="HeroBg" Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#183845" Offset="0"/>
                                                            <GradientStop Color="#114858" Offset="0.55"/>
                                                            <GradientStop Color="#112733" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HeroBg" Property="Opacity" Value="0.92"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Accent}" Margin="0,0,13,0">
                                            <Path Data="M 7,2 L 7,12 M 2,7 L 12,7" Width="15" Height="15" Stretch="Uniform"
                                                  Stroke="{StaticResource AccentDark}" StrokeThickness="2.2" StrokeStartLineCap="Round"/>
                                        </Border>
                                        <TextBlock Text="开始创作" FontSize="22" FontWeight="SemiBold" Foreground="#F6F8FA" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="新建本地视频工程 · 多轨剪辑、画中画与全格式导出" FontSize="12"
                                               Foreground="#9CC6D1" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Hero 2: Image Format Converter -->
                            <Button x:Name="HomeImageConvertBtn" Grid.Column="2" Click="HomeImageConvertClick" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    AutomationProperties.Name="图片格式转换">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="HeroBg" CornerRadius="14" BorderThickness="1" BorderBrush="#2D3E6B" SnapsToDevicePixels="True">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#181F36" Offset="0"/>
                                                    <GradientStop Color="#1B2E4E" Offset="0.55"/>
                                                    <GradientStop Color="#111C2E" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeroBg" Property="BorderBrush" Value="#7A88F5"/>
                                                <Setter TargetName="HeroBg" Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#202947" Offset="0"/>
                                                            <GradientStop Color="#223A61" Offset="0.55"/>
                                                            <GradientStop Color="#16243B" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HeroBg" Property="Opacity" Value="0.92"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Width="34" Height="34" CornerRadius="9" Background="#7A88F5" Margin="0,0,13,0">
                                            <Path Data="M 1.5,3 L 12.5,3 L 12.5,11.5 L 1.5,11.5 Z M 3.5,9.5 L 6,6.8 L 8.2,9 L 9.8,7.5 L 11.5,9.5 M 4.8,5.3 A 0.9,0.9 0 1 0 4.8,7.1 A 0.9,0.9 0 1 0 4.8,5.3 Z"
                                                  Width="16" Height="14" Stretch="Uniform"
                                                  Stroke="#0C1020" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"/>
                                        </Border>
                                        <TextBlock Text="图片格式转换" FontSize="22" FontWeight="SemiBold" Foreground="#F6F8FA" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="单张或批量互转 · PNG / JPG / WebP / HEIC / AVIF / BMP / TIFF" FontSize="12"
                                               Foreground="#A6B4DE" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Local Drafts Header -->
                        <DockPanel Grid.Row="1" Margin="2,30,2,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="210" Margin="0,0,8,0">
                                    <TextBox x:Name="HomeDraftSearch" Height="30" MinHeight="30" Padding="28,4,8,4"
                                             TextChanged="HomeDraftSearchChanged" AutomationProperties.Name="搜索本地草稿"/>
                                    <Path Data="M 5.5,1 A 4.5,4.5 0 1 0 5.5,10 A 4.5,4.5 0 1 0 5.5,1 Z M 9,9 L 12,12"
                                          Width="11.5" Height="11.5" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.35"
                                          StrokeStartLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Margin="9,0,0,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="搜索本地草稿" Margin="29,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=HomeDraftSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Style="{StaticResource GhostButton}" Height="30" Padding="11,0" Click="HomeOpenDraftFileClick"
                                        ToolTip="打开硬盘中的 .qingjian 项目文件 · Ctrl+O">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 1.5,4 L 6,4 L 7.5,6 L 13.5,6 L 13.5,12.5 L 1.5,12.5 Z"
                                              Width="12.5" Height="12.5" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.35" StrokeLineJoin="Round" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="打开草稿…" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="本地草稿" FontSize="16.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="9" Padding="8,1.5" Margin="9,1,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HomeDraftCount" Text="0" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                               Foreground="{StaticResource Muted}"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <!-- Local Draft Cards Wrap Grid -->
                        <Grid Grid.Row="2">
                            <ItemsControl x:Name="HomeDraftList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="206" Margin="0,0,14,16" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                Click="HomeDraftCardClick" MouseRightButtonUp="HomeDraftRightClick" Tag="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="DraftCard" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                                            BorderThickness="1" CornerRadius="10" Padding="7" SnapsToDevicePixels="True">
                                                        <StackPanel>
                                                            <Border Height="112" CornerRadius="7" Background="#0A0C10" ClipToBounds="True">
                                                                <Grid>
                                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <Path Data="M 2,3 L 16,3 L 16,13 L 2,13 Z M 7.2,5.8 L 11.8,8 L 7.2,10.2 Z"
                                                                              Width="26" Height="20" Stretch="Uniform" Stroke="#353B48" StrokeThickness="1.3"/>
                                                                    </StackPanel>
                                                                    <Border Background="#C8080A0D" CornerRadius="4" Padding="5,1.5"
                                                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                                                        <TextBlock Text="{Binding Format}" FontFamily="Cascadia Mono, Consolas"
                                                                                   FontSize="9.5" Foreground="{StaticResource Accent}"/>
                                                                    </Border>
                                                                    <Border Background="#C8080A0D" CornerRadius="4" Padding="5,1.5"
                                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                                                                        <TextBlock Text="{Binding DurationText}" FontFamily="Cascadia Mono, Consolas"
                                                                                   FontSize="9.5" Foreground="#EDEDEF"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"
                                                                       Margin="3,8,3,0" ToolTip="{Binding Path}"/>
                                                            <TextBlock Text="{Binding MetaText}" FontSize="11" Foreground="{StaticResource Muted}"
                                                                       TextTrimming="CharacterEllipsis" Margin="3,2,3,2"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="DraftCard" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                                                            <Setter TargetName="DraftCard" Property="BorderBrush" Value="{StaticResource AccentBorder}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty Drafts State -->
                            <Border x:Name="HomeDraftEmpty" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="12" Padding="24,46" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource Raised}"
                                            BorderBrush="{StaticResource LineStrong}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <Path Data="M 2,5 L 8,5 L 10,7.5 L 20,7.5 L 20,17 L 2,17 Z" Width="20" Height="16"
                                              Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                    </Border>
                                    <TextBlock x:Name="HomeDraftEmptyTitle" Text="暂无本地草稿" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HomeDraftEmptyHint" Text="点击上方「开始创作」新建项目，或直接将 .qingjian 草稿与视频文件拖入窗口"
                                               Style="{StaticResource MutedText}" Margin="0,6,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- EXPORT / PREVIEW RENDER OVERLAY -->
            <Border Grid.RowSpan="5" x:Name="ExportOverlay" Background="#C807080B" Visibility="Collapsed" Panel.ZIndex="3">
                <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" CornerRadius="12"
                        Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                        KeyboardNavigation.TabNavigation="Cycle">
                    <StackPanel>
                        <TextBlock x:Name="ExportHeading" Text="正在导出视频" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ExportStatus" Margin="0,6,0,16" Text="正在准备编码器…" Style="{StaticResource SecondaryText}"/>
                        <ProgressBar x:Name="ExportProgress" Height="6" Maximum="100" AutomationProperties.Name="导出进度"/>
                        <Button x:Name="CancelExportButton" Content="取消" HorizontalAlignment="Right" Click="CancelExportClick"
                                Margin="0,18,0,0" MinWidth="82"/>
                        <StackPanel x:Name="ExportResultActions" Orientation="Horizontal" Visibility="Collapsed"
                                    HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Content="打开所在文件夹" Click="OpenExportFolder" Margin="0,0,8,0"/>
                            <Button x:Name="ExportDoneButton" Content="完成" Click="CloseExportResult" Style="{StaticResource Primary}" Width="78"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
