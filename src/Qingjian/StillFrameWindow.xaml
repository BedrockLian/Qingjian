<Window x:Class="Qingjian.StillFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出静帧 / 图片格式转换" Width="530" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="SfChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Choice" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="4.5" Padding="6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="{StaticResource Raised}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="{StaticResource AccentSubtle}"/>
                                <Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource AccentBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>

        <Border Padding="18,0" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock x:Name="TimeBadge" DockPanel.Dock="Right" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 1.5,4 L 4.5,4 L 6,2 L 10,2 L 11.5,4 L 14.5,4 L 14.5,12.5 L 1.5,12.5 Z M 8,5.8 A 2.6,2.6 0 1 0 8,11 A 2.6,2.6 0 1 0 8,5.8 Z"
                          Width="14" Height="13" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.35"
                          Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DialogTitleText" Text="导出静帧画面" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,14">
            <!-- Source Image Picker (only shown in Image Convert mode) -->
            <StackPanel x:Name="SourceSection" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock Text="源图片（支持 PNG / JPG / WebP / BMP / TIFF / AVIF / HEIC，支持多选批量转换）"
                           Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="选择图片…" Click="PickSourcesClick" Height="30" MinHeight="30"
                            Padding="10,0" Margin="6,0,0,0"/>
                    <TextBox x:Name="SourceSummaryBox" IsReadOnly="True" Height="30" MinHeight="30" Padding="9,3"
                             Foreground="{StaticResource TextSecondary}"/>
                </DockPanel>
            </StackPanel>

            <StackPanel x:Name="NameSection">
                <TextBlock Text="文件名称" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Height="30" MinHeight="30" Padding="9,3"/>
            </StackPanel>

            <TextBlock Text="保存至" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,4"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseClick" Height="30" MinHeight="30" Padding="10,0" Margin="6,0,0,0"/>
                <TextBox x:Name="FolderBox" Height="30" MinHeight="30" Padding="9,3"/>
            </DockPanel>

            <TextBlock Text="目标图片格式" Style="{StaticResource MutedText}" FontSize="11" Margin="0,11,0,4"/>
            <Border Background="#0E1014" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="2.5">
                <UniformGrid Rows="1">
                    <RadioButton x:Name="FmtPng" GroupName="SfFmt" Content="PNG" IsChecked="True" Style="{StaticResource SfChoice}" Checked="FormatChanged"/>
                    <RadioButton x:Name="FmtJpg" GroupName="SfFmt" Content="JPG" Style="{StaticResource SfChoice}" Checked="FormatChanged"/>
                    <RadioButton x:Name="FmtWebp" GroupName="SfFmt" Content="WebP" Style="{StaticResource SfChoice}" Checked="FormatChanged"/>
                    <RadioButton x:Name="FmtHeic" GroupName="SfFmt" Content="HEIC" Style="{StaticResource SfChoice}" Checked="FormatChanged"/>
                    <RadioButton x:Name="FmtAvif" GroupName="SfFmt" Content="AVIF" Style="{StaticResource SfChoice}" Checked="FormatChanged"/>
                    <RadioButton x:Name="FmtBmp" GroupName="SfFmt" Content="BMP" Style="{StaticResource SfChoice}" Checked="FormatChanged"/>
                    <RadioButton x:Name="FmtTiff" GroupName="SfFmt" Content="TIFF" Style="{StaticResource SfChoice}" Checked="FormatChanged"/>
                </UniformGrid>
            </Border>
            <TextBlock x:Name="FormatDescText" Text="PNG 无损压缩 · 保留完整像素与透明度" Style="{StaticResource MutedText}"
                       FontSize="10.5" Margin="2,4,0,0"/>

            <TextBlock Text="输出尺寸" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,4"/>
            <Border Background="#0E1014" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="2.5">
                <UniformGrid Rows="1">
                    <RadioButton x:Name="ResOrig" GroupName="SfRes" Content="原画尺寸" Style="{StaticResource SfChoice}" Visibility="Collapsed"/>
                    <RadioButton x:Name="Res720" GroupName="SfRes" Content="720P" Style="{StaticResource SfChoice}"/>
                    <RadioButton x:Name="Res1080" GroupName="SfRes" Content="1080P" IsChecked="True" Style="{StaticResource SfChoice}"/>
                    <RadioButton x:Name="Res1440" GroupName="SfRes" Content="2K" Style="{StaticResource SfChoice}"/>
                    <RadioButton x:Name="Res2160" GroupName="SfRes" Content="4K" Style="{StaticResource SfChoice}"/>
                </UniformGrid>
            </Border>

            <!-- Quality & Lossless controls (auto shown for JPG / WebP / AVIF) -->
            <Border x:Name="QualityPanel" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,8"
                    CornerRadius="6" Background="#101217" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="QualityValText" DockPanel.Dock="Right" Text="92" FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11.5" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="压缩画质（50 – 100）" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Slider x:Name="QualitySlider" Minimum="50" Maximum="100" Value="92" IsSnapToTickEnabled="True"
                            TickFrequency="1" Margin="0,5,0,0" ValueChanged="QualitySliderChanged"/>
                    <CheckBox x:Name="WebpLosslessCheck" Content="WebP 无损模式（体积略大，画质零损失）"
                              Margin="0,6,0,0" Visibility="Collapsed" Checked="FormatChanged" Unchecked="FormatChanged"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="#FF8787" FontSize="11" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" Padding="18,0" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="取消" IsCancel="True" Width="74" Height="30" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmBtn" Content="导出图片" Style="{StaticResource Primary}" IsDefault="True"
                        Click="ConfirmClick" MinWidth="104" Height="30" Padding="14,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
